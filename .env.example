# Copiar a .env y ajustar. El archivo .env esta en .gitignore: NUNCA se versiona.
#   cp .env.example .env

# --- Base de datos -----------------------------------------------------------
DB_NAME=rescate_animal
DB_USER=rescate
DB_PASSWORD=cambiar-en-local
DB_PORT=5432

# --- Aplicacion --------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=default
JPA_DDL_AUTO=update

# --- JWT ---------------------------------------------------------------------
# Minimo 32 caracteres. Generar uno propio, por ejemplo:
#   openssl rand -base64 48
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRATION=86400000

# --- Correo saliente (RF-17) -------------------------------------------------
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=

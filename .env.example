# Plantilla de variables de entorno. Copiar a .env y ajustar:
#   cp .env.example .env
#
# El .env real esta en .gitignore y NUNCA se versiona. Este .example si se
# versiona, asi que no debe contener ninguna credencial real.
#
# QUIEN LEE ESTE FICHERO. Docker Compose, para levantar la base de datos. Spring
# Boot no lo lee al arrancar la aplicacion: la configuracion de cuando se ejecuta
# desde IntelliJ va en src/main/resources/application-local.properties (perfil
# "local"), que tambien esta gitignoreado.
#
# CON UNA EXCEPCION QUE CONVIENE SABER: el perfil de pruebas SI importa este
# fichero -spring.config.import en src/test/resources/application-test.properties-
# para no versionar las credenciales de la base de datos. Todo lo que pongas aqui
# acaba tambien en el entorno de la suite de pruebas, asi que no metas variables
# que pisen la configuracion de la aplicacion.

# --- Base de datos (lo lee docker-compose.yml) -------------------------------
DB_NAME=rescate_animal
DB_USER=cambiar-usuario
DB_PASSWORD=cambiar-contrasena

# Puerto en el que el contenedor publica PostgreSQL. Si ya tienes un PostgreSQL
# instalado en tu maquina, tendra ocupado el 5432 y el contenedor no podra
# arrancar: usa entonces 5433. Comprueba quien ocupa el puerto con
#   netstat -ano | findstr :5432
# Este valor debe coincidir con el puerto de spring.datasource.url en
# src/main/resources/application-local.properties.
DB_PORT=5432

# --- JWT ---------------------------------------------------------------------
# Sin valor por defecto: si falta, la aplicacion no arranca.
#
# GENERALO AL AZAR, no lo elijas a mano. La firma de los tokens de acceso y la de
# los enlaces de recuperacion de contrasena no valen mas que este secreto, y una
# frase de varias palabras se rompe fuera de linea con un solo token capturado:
# basta con registrarse para tener uno. Minimo 32 caracteres (HS256).
#
#   openssl rand -base64 48
#
# El marcador de abajo es DEMASIADO CORTO a proposito: si copias este fichero y
# se te olvida cambiarlo, la aplicacion se niega a arrancar en vez de firmar con
# un secreto que esta publicado en el repositorio.
JWT_SECRET=cambiar-generar-con-openssl

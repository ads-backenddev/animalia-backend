# Plantilla de variables de entorno. Copiar a .env y ajustar:
#   cp .env.example .env
#
# El .env real esta en .gitignore y NUNCA se versiona. Este .example si se
# versiona, asi que no debe contener ninguna credencial real.
#
# IMPORTANTE: este fichero lo lee unicamente Docker Compose, para levantar la
# base de datos. Spring Boot NO lee ficheros .env: la configuracion de la
# aplicacion cuando se arranca desde IntelliJ va en
# src/main/resources/application-local.properties (perfil "local"), que tambien
# esta gitignoreado.

# --- Base de datos (lo lee docker-compose.yml) -------------------------------
DB_NAME=rescate_animal
DB_USER=cambiar-usuario
DB_PASSWORD=cambiar-contrasena

# Puerto en el que el contenedor publica PostgreSQL. Si ya tienes un PostgreSQL
# instalado en tu maquina, tendra ocupado el 5432 y el contenedor no podra
# arrancar: usa entonces 5433. Comprueba quien ocupa el puerto con
#   netstat -ano | findstr :5432
# Este valor debe coincidir con el puerto de spring.datasource.url en
# src/main/resources/application-local.properties.
DB_PORT=5432
